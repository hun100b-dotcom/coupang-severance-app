# 배포 시 Vercel 등에서 설정할 API 주소 (끝에 /api 포함)
# 예: https://coupang-severance-api.onrender.com/api
# 비워두면 로컬 개발 시 /api (프록시 → localhost:8000) 사용
VITE_API_URL=

# 고객센터 Auth·문의 DB (Supabase)
# Supabase 대시보드 → Settings → API → Project URL / anon public
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오 JavaScript 앱 키 (카카오톡 공유 기능용)
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 설정 → 앱 키 → JavaScript 키
# 미설정 시 공유 버튼 클릭 시 URL 클립보드 복사 fallback으로 동작
VITE_KAKAO_JS_KEY=
