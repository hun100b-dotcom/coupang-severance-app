<?xml version="1.0" encoding="UTF-8"?>
<!--
  sitemap.xml — 검색 크롤러(Googlebot 등)가 사이트 페이지 구조를 파악하는 데 사용
  - loc: 페이지 URL
  - changefreq: 예상 변경 주기 (크롤 빈도 힌트, 강제 아님)
  - priority: 0.0~1.0 상대적 중요도 (같은 사이트 내 페이지 간 우선순위)
  Google Search Console에 등록하면 인덱싱 속도가 빨라짐
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- 홈: 최고 우선순위, 주간 변경 (공지·채용 업데이트) -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/home</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- 퇴직금 계산기: 핵심 기능 페이지 -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/severance</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- 실업급여 계산기: 핵심 기능 페이지 -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/unemployment</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- 주휴수당 계산기 -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/weekly-allowance</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- 연차수당 계산기 -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/annual-leave</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- 채용정보: 매일 새 공고 올라오므로 daily -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/jobs</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- 내 혜택 조회 페이지 -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/my-benefits</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>

  <!-- 공지사항 -->
  <url>
    <loc>https://catch-daily-worker.vercel.app/notices</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>

</urlset>
